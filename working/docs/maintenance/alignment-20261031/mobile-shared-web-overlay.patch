diff --git a/web/web前端/platform/TutorialHost.js b/web/web前端/platform/TutorialHost.js
new file mode 100644
--- /dev/null
+++ b/web/web前端/platform/TutorialHost.js
@@ -0,0 +1,27 @@
+export function createTutorialTarget(currentHref) {
+  const current = new URL(currentHref);
+  if (!['http:', 'https:'].includes(current.protocol) || current.username || current.password) {
+    throw new Error('invalid-tutorial-url');
+  }
+  const target = new URL(current.pathname === '/index.html' ? '/index.html' : '/', current.origin);
+  target.searchParams.set('tutorial', '1');
+  return target.href;
+}
+
+export async function openTutorialTarget({ platform, currentHref, open = globalThis.open }) {
+  const target = createTutorialTarget(currentHref);
+  if (platform?.isNative) {
+    if (typeof platform.openTutorial !== 'function') throw new Error('tutorial-host-unavailable');
+    const requested = new URL(target);
+    const source = new URL(currentHref);
+    if (requested.origin !== source.origin || requested.searchParams.get('tutorial') !== '1') {
+      throw new Error('invalid-tutorial-url');
+    }
+    const result = await platform.openTutorial(target);
+    if (result?.status !== 'opened') throw new Error('tutorial-host-failed');
+    return { status: 'opened', target };
+  }
+  if (typeof open !== 'function') throw new Error('tutorial-host-unavailable');
+  open(target, '_blank', 'noopener');
+  return { status: 'opened', target };
+}
diff --git a/web/web前端/platform/runtime.js b/web/web前端/platform/runtime.js
