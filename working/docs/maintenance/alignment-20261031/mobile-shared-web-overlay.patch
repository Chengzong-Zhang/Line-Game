+++ b/web/web前端/platform/runtime.js
@@ -0,0 +1,9 @@
+export function configuredEndpoint(name, allowedProtocols) {
+  const configured = globalThis.__LIFELINE_RUNTIME_CONFIG__?.[name];
+  if (typeof configured !== "string" || !configured.trim()) return null;
+  const url = new URL(configured);
+  if (!allowedProtocols.includes(url.protocol) || url.username || url.password) throw new Error(`Invalid configured endpoint: ${name}`);
+  return url.toString();
+}
+
+export const isMobileShell = () => globalThis.__LIFELINE_MOBILE_APP__ === true;
