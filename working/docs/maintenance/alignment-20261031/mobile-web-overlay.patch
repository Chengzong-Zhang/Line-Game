diff --git a/web/web前端/tests/verify-local-runtime-loaders.mjs b/web/web前端/tests/verify-local-runtime-loaders.mjs
new file mode 100644
--- /dev/null
+++ b/web/web前端/tests/verify-local-runtime-loaders.mjs
@@ -0,0 +1,94 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { webcrypto } from "node:crypto";
+import GameEngine from "../GameEngine.js?v=20261024-l34a1";
+import { serializeEngineState } from "../AIStateProtocol.js?v=20261024-l34a1";
+import { createSupportedThreePlayerModel } from "../ThreePlayerModels.js?v=20261024-l34a1";
+
+if (!globalThis.crypto?.subtle) globalThis.crypto = webcrypto;
+const modelDir = new URL("../assets/research-ai/", import.meta.url);
+for (const id of ["three-player-policy-v2", "three-player-policy-v3"]) {
+  const payload = JSON.parse(await readFile(new URL(`${id}.json`, modelDir), "utf8"));
+  assert.equal(createSupportedThreePlayerModel(payload).spec.id, id, `${id} frozen provenance is accepted`);
+  if (id === "three-player-policy-v2") {
+    const missingValidation = structuredClone(payload);
+    delete missingValidation.training.validation_samples;
+    assert.throws(() => createSupportedThreePlayerModel(missingValidation), /格式或后训练来源无效/,
+      "v2 requires its declared validation sample count");
+  } else {
+    for (const field of ["parent_posttraining_samples", "completed_generation_episodes", "completed_development_games"]) {
+      const missing = structuredClone(payload);
+      delete missing.training[field];
+      assert.throws(() => createSupportedThreePlayerModel(missing), /格式或后训练来源无效/,
+        `v3 requires its declared ${field}`);
+    }
+    const badParent = structuredClone(payload);
+    badParent.training.parent_model_sha256 = "0".repeat(64);
+    assert.throws(() => createSupportedThreePlayerModel(badParent), /格式或后训练来源无效/,
+      "v3 parent provenance tampering is rejected");
+    const missingProtocol = structuredClone(payload);
+    delete missingProtocol.training.protocol_sha256;
+    assert.throws(() => createSupportedThreePlayerModel(missingProtocol), /格式或后训练来源无效/,
+      "v3 missing protocol provenance is rejected");
+    const malformedSource = structuredClone(payload);
+    malformedSource.training.source_hashes["web/tools/finetune-three-player-v3.mjs"] = "not-a-hash";
+    assert.throws(() => createSupportedThreePlayerModel(malformedSource), /格式或后训练来源无效/,
+      "v3 malformed source provenance is rejected");
+  }
+}
+const originalFetch = globalThis.fetch;
+const originalSelf = globalThis.self;
+const messages = [];
+globalThis.fetch = async (value) => {
+  const url = new URL(String(value));
+  url.search = "";
+  return new Response(await readFile(url));
+};
+globalThis.self = { postMessage: (message) => messages.push(message) };
+try {
+  await import("../AIWorker.js?v=20261024-l34a1");
+  let requestId = 0;
+  const run = async ({ playerCount, boardShape, strategy, modelId, rulesVersion = "territory-v2", fixtureMoves = [] }) => {
+    const engine = new GameEngine({ gridSize: 5, playerCount, boardShape, rulesVersion });
+    for (const point of fixtureMoves) {
+      const result = engine.playMove(point);
+      assert.equal(result.success, true, `${rulesVersion} shared fixture move ${point}`);
+    }
+    const serializedState = serializeEngineState(engine);
+    await self.onmessage({ data: { type: "COMPUTE", serializedState, aiPlayer: engine.currentPlayer, strategy, modelId, topN: 2, requestId: ++requestId } });
+    const response = messages.pop();
+    assert.equal(response.type, "RESULT", `${strategy}/${modelId}: ${response.message}`);
+    assert.equal(response.requestId, requestId, `${strategy}/${modelId}: request identity is preserved`);
+    assert.equal(response.rulesVersion, rulesVersion, `${strategy}/${modelId}: rules version is preserved`);
+    assert.equal(response.positionRevision, serializedState.positionRevision ?? 0,
+      `${strategy}/${modelId}: position revision is preserved`);
+    assert.equal(response.currentPlayer, serializedState.currentPlayer,
+      `${strategy}/${modelId}: acting player is preserved`);
+    assert.equal(response.modelInfo?.id ?? strategy, modelId ?? strategy);
+    assert.ok(response.moves.length > 0);
+    for (const move of response.moves) assert.ok(move.type === "pass"
+      || engine.getLegalMoves(engine.currentPlayer).some((legal) => legal.point.join(",") === move.point?.join(",")));
+  };
