diff --git a/web/web前端/tests/verify-online-bot-ui.mjs b/web/web前端/tests/verify-online-bot-ui.mjs
new file mode 100644
--- /dev/null
+++ b/web/web前端/tests/verify-online-bot-ui.mjs
@@ -0,0 +1,59 @@
+import assert from "node:assert/strict";
+import { readFile } from "node:fs/promises";
+import { PLAYER_COUNT_OPTIONS } from "../OnlineAppState.js";
+import { formatPlayerName, getTexts } from "../OnlineAppI18n.js";
+import { Player, PLAYER_ORDER, resolveInitialPositions } from "../GameEngine.js";
+
+const onlineApp = await readFile(new URL("../OnlineApp.js", import.meta.url), "utf8");
+const styles = await readFile(new URL("../styles.css", import.meta.url), "utf8");
+
+assert.deepEqual(PLAYER_COUNT_OPTIONS, [2, 3, 4, 5, 6]);
+assert.match(onlineApp, /class="language-switcher language-switcher-inline player-count-choices"[\s\S]*?v-for="count in PLAYER_COUNT_OPTIONS"/);
+assert.match(onlineApp, /v-if="playerCount >= 3 && !session\.roomId"[\s\S]*?v-for="count in playerCount"/,
+  "3–6 seat room setup exposes bot counts while preserving at least one human seat");
+assert.match(onlineApp, /texts\.value\.roomBotPlayerName\(formatAppPlayerName\(player\.color/,
+  "room bot labels use localized player-color names and localized wrapper text");
+assert.match(onlineApp, /class="action-button action-button-ghost"[^>]*@click="\$emit\('retry-bots'\)"[^>]*>\s*\{\{ texts\.roomRetryBots \}\}/,
+  "host bot-error retry action is connected to the room component event");
+assert.match(onlineApp, /v-if="isHost && roomInfo\?\.settings\?\.botCount && roomPlaying && roomInfo\?\.botError"[^>]*@click="\$emit\('retry-bots'\)"/,
+  "only the playing host sees retry while a bot room reports an error");
+assert.match(onlineApp, /const retryRoomBots = \(\) => networkManager\.retryBots\(\)\.catch\(handleNetworkError\)/,
+  "the room retry event reaches the network manager");
+assert.match(onlineApp, /@retry-bots="retryRoomBots"/,
+  "the playing host retry button is wired through the room panel");
+assert.match(styles, /\.player-count-choices\s*\{\s*display:\s*grid;\s*grid-template-columns:\s*repeat\(5,\s*minmax\(0,\s*1fr\)\);\s*\}/,
+  "the player count row uses five equal narrow-safe columns");
+assert.match(styles, /\.player-count-choices \.language-button\s*\{\s*min-width:\s*0;\s*padding-inline:\s*8px;\s*\}/,
+  "player count buttons can shrink at narrow mobile widths");
+for (const colorClass of ["is-green", "is-orange", "is-cyan"]) {
+  assert.ok(onlineApp.includes(`"${colorClass}": option.value`), `starter color styling includes ${colorClass}`);
+}
+assert.match(onlineApp, /if \(APP_ALL_PLAYERS\.includes\(payloadColor\)\)/,
+  "chat emoji payloads preserve every supported player color");
+assert.match(onlineApp, /settings\.initialPositions \?\? resolveInitialPositions\(settings\.gridSize, settings\.playerCount, null, settings\.boardShape\)/,
+  "chat emoji anchors use the current match's actual opening positions");
+assert.match(onlineApp, /getPlayerAccentClass\(color\)\.replace\("player-accent-", ""\)/,
+  "chat emoji colors use the shared six-color player accent mapping");
+for (const count of [4, 5, 6]) {
+  const positions = resolveInitialPositions(5, count, null, "hexagon");
+  const anchors = PLAYER_ORDER.slice(0, count).map((color) => {
+    const point = positions[color];
+    const r = 4;
+    const nx = point[0] + point[1] / 2;
+    return [
+      14 + 72 * (nx - r / 2) / (2 * r),
+      14 + 72 * point[1] / (2 * r),
+    ];
+  });
+  assert.equal(new Set(anchors.map(([x, y]) => `${x.toFixed(3)},${y.toFixed(3)}`)).size, count,
+    `${count}-player hex emoji anchors stay distinct`);
+}
+
+const green = formatPlayerName(Player.GREEN, "en");
+const greenZh = formatPlayerName(Player.GREEN, "zh");
+assert.equal(getTexts("en").roomBotPlayerName(green), "AI (Green)");
+assert.equal(getTexts("zh").roomBotPlayerName(greenZh), "AI（绿方）");
+assert.equal(getTexts("en").roomRetryBots, "Retry AI turn");
+assert.equal(getTexts("zh").roomRetryBots, "重试 AI 回合");
+
+console.log("Online bot UI regression passed: 4–6 seat entry, localized bot labels, and six starter colors.");
