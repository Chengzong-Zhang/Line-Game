+export function parseLocalGameSessionRecord(raw) {
+  try {
+    let value = JSON.parse(String(raw));
+    if (value?.format === SESSION_ENVELOPE_FORMAT) {
+      if (value.version !== 1 || !Number.isSafeInteger(value.revision) || value.revision < 1
+        || value.state !== "saved" || typeof value.payload !== "string") return null;
+      value = JSON.parse(value.payload);
+    }
+    const session = normalizeSession(value);
+    if (!session) return null;
+    const engine = new GameEngine({ ...session.settings });
+    for (const action of session.actions) {
+      let result;
+      if (action.type === "player_move") result = engine.playMove(action.point);
+      else if (action.type === "player_skip") result = engine.skipTurn();
+      else if (action.type === "player_resign") result = engine.resignPlayer(action.color);
+      else if (action.type === "player_root_relocate") result = engine.playRootAction("relocate", action.point);
+      else if (action.type === "player_root_add") result = engine.playRootAction("add", action.point);
+      else return null;
+      if (!result?.success && result?.reason !== "PLAYER_ALREADY_RESIGNED") return null;
+    }
+    return session;
+  } catch (_error) { return null; }
+}
+
+export function isLocalGameSessionRecordCorrupt(raw) {
+  if (raw == null || raw === "") return false;
+  try {
+    const value = JSON.parse(String(raw));
+    if (value?.format === SESSION_ENVELOPE_FORMAT) {
+      if (value.version !== 1 || !Number.isSafeInteger(value.revision) || value.revision < 1) return true;
+      if (value.state === "cleared") return Object.hasOwn(value, "payload");
+      if (value.state !== "saved" || typeof value.payload !== "string") return true;
+    }
+  } catch (_error) { return true; }
+  return parseLocalGameSessionRecord(raw) === null;
+}
