{
  "name": "lifeline-itch-release",
  "private": true,
  "type": "module",
  "version": "0.4.0-itch.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "node tools/build-html5.mjs",
    "verify:model-assets": "node tests/verify-model-assets.mjs",
    "verify": "npm run verify:model-assets && node tests/verify-html5-build.mjs",
    "verify:browser": "node tests/verify-browser.mjs",
    "verify:multiplayer-browser": "node tests/verify-multiplayer-browser.mjs",
    "verify:determinism": "node tests/verify-deterministic-build.mjs",
    "release:local": "npm run build && npm run verify",
    "serve:validation": "node tools/serve-validation.mjs",
    "serve:runtime-validation": "node tools/serve-runtime-validation.mjs",
    "push": "npm run release:local && node tools/push-butler.mjs"
  },
  "dependencies": {
    "@fontsource/cormorant-garamond": "5.3.0",
    "@fontsource/manrope": "5.3.0",
    "mathjax": "3.2.2",
    "vue": "3.5.44"
  },
  "devDependencies": {
    "fflate": "0.8.3",
    "playwright-core": "1.64.1"
  }
}
